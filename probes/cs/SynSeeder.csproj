<Project Sdk="Microsoft.NET.Sdk">
  <!-- Trial of a native SynSeeder on .NET Framework 4.8 (built into Windows 10
       and 11), to see whether it scans clean on VirusTotal. Build one of three
       variants with -p:Variant=full|noupdate|bare:
         full      every part the real app needs, including the self-update
         noupdate  the same, but "update" only opens the release page
         bare      just a window, as a baseline -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SynSeeder</AssemblyName>
    <RootNamespace>SynSeeder</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ApplicationIcon>..\..\assets\synseeder.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.9.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>SynSeeder</Product>
    <AssemblyTitle>SynSeeder</AssemblyTitle>
    <Description>Seeds a Hell Let Loose: Vietnam server</Description>
    <Company>waterjugs</Company>
    <Copyright>Copyright (c) waterjugs</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <Variant Condition="'$(Variant)' == ''">full</Variant>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Variant)' == 'full'">
    <DefineConstants>$(DefineConstants);SELF_UPDATE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the build run anywhere, without the Windows targeting pack. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup Condition="'$(Variant)' == 'bare'">
    <Compile Remove="**\*.cs" />
    <Compile Include="Bare.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Variant)' != 'bare'">
    <Compile Remove="Bare.cs" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.CSharp" />
    <EmbeddedResource Include="..\..\templates\*.png" LogicalName="templates/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
